# Copia este archivo como .env (o .env.local en Next.js) y completa los valores.
# NUNCA subas el archivo .env al repositorio.

# --- Entorno ---
NODE_ENV=development

# --- Backend (Node.js) ---
PORT=4000
# Cambia este valor por una cadena larga y aleatoria. No la compartas ni la publiques.
JWT_SECRET=cambia_este_valor
JWT_EXPIRES_IN=1h

# --- Logs ---
# Niveles sugeridos: error | warn | info | debug
LOG_LEVEL=info

# --- Frontend (Next.js) ---
# Las variables con prefijo NEXT_PUBLIC_ se exponen al navegador: no pongas secretos aquí.
NEXT_PUBLIC_API_URL=http://localhost:4000
